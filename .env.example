# Required. The memory database: the service reads `user_identity` from it and creates its own
# `fleet_session` table there. It carries the password, so it is the one secret this server holds.
EINHERJAR_DB_URL=postgresql://user:password@127.0.0.1:5432/valaskjalf

# Hosted shape: set the issuer and the public URL, and bind everywhere. Tokens bind to the public
# URL as their audience, so it must match the Resource Indicator registered with the issuer.
# EINHERJAR_LOGTO_ENDPOINT=https://auth.lok.quest
# EINHERJAR_PUBLIC_BASE_URL=https://einherjar.lok.quest
# EINHERJAR_HOST=0.0.0.0
# EINHERJAR_PORT=8220

# Local shape: no issuer, a loopback host and a loopback public URL. The guard refuses anything
# else. `EINHERJAR_LOCAL_BIND_ALL=1` is the acknowledgement for a bind that something in front of
# the process keeps private.
# EINHERJAR_LOCAL_BIND_ALL=1
